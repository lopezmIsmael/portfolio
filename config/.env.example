# Ejemplo de configuración de variables de entorno
# Copia este archivo como .env.local para usarlo

# GitHub Token (Opcional)
# Aumenta el límite de requests de la API de GitHub de 60 a 5000 por hora
# Para obtenerlo: GitHub → Settings → Developer settings → Personal access tokens
# NO necesitas permisos especiales para repos públicos
# NEXT_PUBLIC_GITHUB_TOKEN=tu_token_aquí
